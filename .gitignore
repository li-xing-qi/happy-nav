# ---------- 依赖与构建 ----------
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 环境与密钥（重要：绝不能提交）----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials*
secrets*

# ---------- 运行时数据（重要：会含聊天记录与上传文件）----------
data/
workspace/*
!workspace/.gitkeep
# 例外：并肩割草的平衡数据是静态资源（游戏本体 data_config.js 的源），不是运行时数据
!public/survivor/data/

# ---------- 背景音乐（25MB 的 mp3 不进版本库，用 scripts/fetch-music.sh 重下）----------
public/music/*.mp3

# ---------- 备份与临时文件 ----------
*.bak
*.bak-*
*.broken-*
*.tmp
*.log
logs/
backup/
.tmp/
tmp/

# ---------- 编辑器与系统 ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------- 其他 ----------
*.zip
*.tar.gz
coverage/
.cache/
