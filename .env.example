# ============================================================
# 和鱼的快乐导航 · 环境变量示例
#   复制为 .env 即生效（程序启动时自动读取，无需 dotenv、无需额外参数）
#   已存在的真实环境变量优先，.env 只补空缺 —— 方便 docker / CI 覆盖
#   .env 已被 .gitignore 排除，不要提交
# ============================================================

# ---------- 站点 ----------
# 监听端口
PORT=3000
# 监听地址：0.0.0.0 允许外部访问；只想本机访问填 127.0.0.1
HOST=0.0.0.0
# 单文件上传上限（MB）
MAX_UPLOAD_MB=10

# ---------- 数据与工作区 ----------
# 站点运行数据（房间消息、上传文件等）。留空 = 站点目录下的 data/
DATA_DIR=
# 工作区（人设、长期记忆、流水账、表情库、图片库）。留空 = 站点目录下的 workspace/
WORKSPACE_DIR=

# ---------- AI 接入（可选；不填就只有无 AI 的基础玩法）----------
# 任何 OpenAI 兼容接口都行；本地 Ollama 通常是 http://localhost:11434/v1
LLM_BASE_URL=
# 密钥：留空 = 不启用 AI 对话，其余玩法照常可用
LLM_API_KEY=
# 模型名，例如 deepseek-chat / qwen2.5:7b
LLM_MODEL=
# 请求格式：auto（按地址自动判断）/ openai / ollama
LLM_FORMAT=auto
# 采样温度
LLM_TEMP=0.7

# ---------- 访问控制 ----------
# 破坏性接口（如清理上传文件）默认只允许本机调用。
# 需要远程调用时设置一个令牌，并在请求头 x-auth-token 或 ?token= 中携带。
# 提醒：房间号只是「知道就能进」，不是身份认证；放到公网请自行加反向代理与鉴权。
AUTH_TOKEN=

# ---------- 可选：语音合成 ----------
# 默认关闭。开启后朗读文本会发往微软 Edge 在线服务，不再是纯本地。
# 需要在系统里装 edge-tts：pip3 install edge-tts
TTS_ENABLE=0
# 默认音色
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ---------- 记忆语义裁决（强烈建议使用）----------
# 「是否该记 / 记成什么 / 作用域多长 / 撤销哪条」由模型判断，脚本只做兜底与落盘。
# auto = 配了 LLM_BASE_URL + LLM_API_KEY 就自动启用；没配就走保守兜底（宁可少记，不可错记）
MEMORY_LLM=auto
# 单次裁决超时（毫秒）。超时 / 解析失败 / 低置信度一律降级，绝不阻断主链路
MEMORY_LLM_TIMEOUT_MS=3500
# 低于此置信度的裁决视为「不记」
MEMORY_LLM_MIN_CONFIDENCE=0.6

# ---------- 可选：记忆增强 ----------
# 1 = 启用四层记忆（默认）；0 = 回落到「人设 + 长期记忆全文」的简单模式
FOUR_LAYER=1

# ---------- AI 陪玩进程 agent-bot（可选，需先在 agent-bot/ 里 npm install）----------
# 它负责聊天室陪聊、卡牌队友、五子棋对手、心有灵犀、三款新游戏，共用同一份人设与记忆
#
# 三个路径/地址（agent-bot/config.js 读取；留空各有默认值，见下面每行注释）
#   WORKSPACE_DIR  本文件上文「数据与工作区」那段已定义，agent-bot 复用同一个值
#   CHATLOG        流水账 jsonl，留空 = $WORKSPACE_DIR/chatlog.jsonl
#   SITE_BASE      agent-bot 调站点接口的基址，留空 = http://127.0.0.1:3000
# 本次部署（82.156.178.9）用的就是这三行注释里的值：
#   WORKSPACE_DIR=/root/qq-workspace
#   CHATLOG=/root/qq-workspace/chatlog.jsonl
#   SITE_BASE=http://127.0.0.1:3000
# 注意：这三个变量真实值放在服务器 /root/.env 里（agent-bot 的部署配置，不进版本库），
#       丢了会让 mood/remember 静默退化成内置默认，情绪记录失效。
CHATLOG=
SITE_BASE=

# 想关掉某个场景就设成 1
NO_CHAT=0
NO_CARD=0
NO_GOMOKU=0
NO_LINGXI=0
NO_SURVIVOR=0
# 英雄之战联机队友：鱼只在房主开局前选择「小鱼当队友」时加入
NO_SURVIVOR_COOP=0
# 海龟汤：soup = 鱼当参与者；soup-host = 鱼当主持人
# 两者都只响应玩家在开局前的邀请，不再自动扫房/占固定房号
NO_SOUP=0
NO_SOUP_HOST=0

# 各场景用的房间号（要与站点里的一致）
CHAT_ROOM=0000
CARD_ROOM=main
GOMOKU_ROOM=0000
LINGXI_ROOM=
SURVIVOR_ROOM=main

# 机器人在房间里的身份标识（不能和真人重复）
CHAT_PID=chat-fish
CARD_PID=ai-teammate
GOMOKU_PID=go-fish
LINGXI_PID=lx-fish
SURVIVOR_PID=survivor-fish
SURVIVOR_COOP_PID=survivor-coop-fish
SOUP_PID=soup-fish
SOUP_HOST_PID=soup-host-fish

# ---------- 可选：与鱼桥（需要 dsh，见 docs/接入dsh.md）----------
# 数字 ID；留空则桥接不启动
BOT_QQ=
OWNER_QQ=
OB_URL=ws://127.0.0.1:6199/ws
OB_TOKEN=

# ---------- 可选：画图能力 ----------
# 需要 Chromium/Chrome 与 puppeteer-core；留空会自动探测常见路径
CHROME_BIN=
