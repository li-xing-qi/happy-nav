# ============================================================
# 和鱼的快乐导航 · 环境变量示例
# 复制为 .env 后按需修改；不填也能跑（全部有默认值）
# 注意：.env 里有密钥，已被 .gitignore 排除，不要提交
# ============================================================

# ---------- 站点 ----------
# 监听端口
PORT=3000
# 监听地址：0.0.0.0 表示允许外部访问；只想本机访问填 127.0.0.1
HOST=0.0.0.0
# 单文件上传上限（MB）
MAX_UPLOAD_MB=10

# ---------- 数据与工作区 ----------
# 站点运行数据（房间消息、上传文件等）。留空 = 站点目录下的 data/
DATA_DIR=
# 工作区（人设、长期记忆、流水账、表情库、图片库）。留空 = 站点目录下的 workspace/
WORKSPACE_DIR=

# ---------- 可选：AI 接入 ----------
# 兼容 OpenAI 格式的服务地址，例如你自己的代理或中转服务
LLM_BASE_URL=
# 密钥（留空 = 不启用 AI 对话，其余玩法照常可用）
LLM_API_KEY=
# 模型名
LLM_MODEL=
# 是否流式返回（1 开 / 0 关）
LLM_STREAM=1

# ---------- 可选：语音合成 ----------
# 设为 0 可整体关闭语音接口
TTS_ENABLE=1
# 默认音色
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ---------- 可选：记忆增强 ----------
# 设为 0 可关闭四层记忆增强，回落到「人设 + 长期记忆全文」的简单模式
FOUR_LAYER=1
