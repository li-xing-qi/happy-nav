# 统一换行符，保证跨平台可用
# 关键：shell 脚本必须是 LF，否则在 Linux/macOS 上会报 bad interpreter
* text=auto eol=lf

*.sh    text eol=lf
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.py    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf

# 二进制文件不做转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.mp3   binary
*.wav   binary
*.zip   binary
*.gz    binary
